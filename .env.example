# ============================================================================
# Internext Business System — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================================

# --- App ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5174

# --- Database (dedicated Postgres role/db for this app only) ---
DATABASE_URL=postgres://ibs_app:CHANGE_ME@localhost:5432/internext_ibs

# --- Auth / Sessions ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64_HEX_CHARS
COOKIE_NAME=ibs_session
# Set to true only when serving over HTTPS (production)
COOKIE_SECURE=false

# --- Admin bootstrap (used once by `npm run bootstrap:admin`, never a live HTTP endpoint) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email (provider-agnostic; "console" logs emails instead of sending) ---
EMAIL_PROVIDER=console
EMAIL_FROM="Internext Business System <no-reply@internextbusinesssystem.co.ke>"
# Filled in only when a real provider is wired up:
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# --- M-Pesa Daraja (currently simulated — real credentials only when going live) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_PAYBILL=
MPESA_ACCOUNT_NO=
MPESA_TILL=
